{
  "name": "chatterpay-b2c-analytics-api",
  "version": "0.1.0",
  "private": true,
  "description": "ChatterPay Analytics API: private backend that serves mock analytics behind the site BFF.",
  "license": "UNLICENSED",
  "author": "chatterpay",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "lint:ci": "biome ci .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pre-commit": "yarn lint:fix && yarn type-check && yarn test"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
