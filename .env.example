# Variable names only. Copy to .env for local runs; never commit values.
# development | test | production
NODE_ENV=
# Bind address; the container sets 0.0.0.0
HOST=
# Local default 4001; the container sets 8080
PORT=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=
# Maximum request body in bytes (default 16384)
BODY_LIMIT_BYTES=
# Maximum time to receive a full request in ms (default 10000)
REQUEST_TIMEOUT_MS=
# Shared demo login code, at least 12 characters; required in production, unset answers 503 on verify-code
DEMO_ACCESS_CODE=
# PEM PKCS8 Ed25519 key that signs session JWTs (escaped newlines allowed); required in production, ephemeral when unset
JWT_PRIVATE_KEY=
# kid header of the session JWTs (default dev)
JWT_KEY_ID=
# iss claim of the session JWTs (default chatterpay-analytics-api)
JWT_ISSUER=
# aud claim of the session JWTs (default chatterpay-analytics-site)
JWT_AUDIENCE=
# Session lifetime in minutes, 5-1440 (default 120)
SESSION_TTL_MINUTES=
# Login challenge lifetime in minutes, 1-60 (default 10)
CHALLENGE_TTL_MINUTES=
# mongodb:// or mongodb+srv:// connection string; required in production, unset uses the in-memory store
MONGO_URI=
# Database name (default chatterpay-analytics-dev); the required indexes must exist before startup
MONGO_DB_NAME=
# Connection string of the ChatterPay B2C database, with the database in its path; its `blockchains`
# collection lists the networks. Required in production; empty reuses MONGO_URI
B2C_MONGO_URI=
# B2C database used when B2C_MONGO_URI has no database in its path (default chatterpay-dev)
B2C_MONGO_DB_NAME=
# Service account whose Google ID token may call POST /v1/internal/ingest (Cloud Scheduler job identity); unset keeps it closed
INGEST_SCHEDULER_SA_EMAIL=
# aud of that token (the audience of the scheduler job); set together with INGEST_SCHEDULER_SA_EMAIL
INGEST_OIDC_AUDIENCE=
# true opens the ingestion endpoint to any caller for local runs (default false); refused in production
INGEST_DEV_TRIGGER=
# B2C transaction rows per batch, 100-10000 (default 1000)
INGEST_BATCH_SIZE=
# Ceiling on B2C transaction rows read per run (default 50000)
INGEST_MAX_TRANSACTIONS_PER_RUN=
# Rows inserted this many hours before a run are read again for status changes, 0 disables (default 72)
INGEST_REVISIT_HOURS=
# No batch starts after this many seconds; below the Cloud Run timeout and the scheduler deadline (default 480)
INGEST_MAX_RUN_SECONDS=
# none | coingecko: daily USD snapshot of the non-stable tokens (default none)
PRICES_PROVIDER=
# Ceiling on price provider requests per run, 0-5 (default 1)
PRICES_MAX_CALLS_PER_RUN=
# Seconds between checks for a newer aggregate build (default 300)
METRICS_REFRESH_SECONDS=
