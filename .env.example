# Variable names only. Copy to .env for local runs; never commit values.
# development | test | production
NODE_ENV=
# Bind address; the container sets 0.0.0.0
HOST=
# Local default 4001; the container sets 8080
PORT=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=
# Maximum request body in bytes (default 16384)
BODY_LIMIT_BYTES=
# Maximum time to receive a full request in ms (default 10000)
REQUEST_TIMEOUT_MS=
# Key of the login code verifiers: 32+ random bytes as hex or base64; required in production, ephemeral when unset. Never reuse another secret
OTP_HMAC_SECRET=
# Key of the email and IP identifiers of challenges and counters: same format, different from OTP_HMAC_SECRET; required in production
OTP_EMAIL_HMAC_SECRET=
# Digits of the emailed code, 8-10 (default 8)
OTP_CODE_DIGITS=
# Lifetime of a login code in seconds, 60-600 (default 300)
OTP_TTL_SECONDS=
# Wrong codes a challenge admits, 1-10 (default 5)
OTP_MAX_ATTEMPTS=
# Minimum seconds between two codes for one email, 10-600 (default 60)
OTP_RESEND_COOLDOWN_SECONDS=
# Comma list of waits in seconds before the 2nd, 3rd... code; the last one repeats (default 0,300,900)
OTP_LOCKOUT_STEPS_SECONDS=
# Ceiling of every wait, 60-900 (default 900)
OTP_MAX_LOCKOUT_SECONDS=
# Codes per email and client IP per hour (default 5) and per 24 hours (default 10)
OTP_SENDS_PER_EMAIL_HOUR=
OTP_SENDS_PER_EMAIL_DAY=
# request-code (default 30) and verify-code (default 60) calls per client IP per 15 minutes
OTP_REQUESTS_PER_IP=
OTP_VERIFICATIONS_PER_IP=
# true lets the emails of DEMO_LOGIN_EMAILS sign in with DEMO_ACCESS_CODE and no email (default false); in production only on a -develop Cloud Run service
DEMO_LOGIN_ENABLED=
# Comma list, at most 10, of demo member emails on a demo. subdomain (e.g. admin@demo.example.com); required with DEMO_LOGIN_ENABLED
DEMO_LOGIN_EMAILS=
# Shared code of the demo accounts, at least 12 characters; required with DEMO_LOGIN_ENABLED, unused otherwise
DEMO_ACCESS_CODE=
# simulated (keeps the emails in memory, sends nothing; default; refused in production) | resend
EMAIL_PROVIDER=
# Sending-only Resend API key restricted to the sender domain; required with EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Sender as "Name <address@domain>" on the domain verified in Resend; required with EMAIL_PROVIDER=resend
EMAIL_FROM=
# Origin of the site for the email links, e.g. https://analytics.example.com; required with EMAIL_PROVIDER=resend, HTTPS in production
SITE_URL=
# PEM PKCS8 Ed25519 key that signs session JWTs (escaped newlines allowed); required in production, ephemeral when unset
JWT_PRIVATE_KEY=
# kid header of the session JWTs (default dev)
JWT_KEY_ID=
# iss claim of the session JWTs (default chatterpay-analytics-api)
JWT_ISSUER=
# aud claim of the session JWTs (default chatterpay-analytics-site)
JWT_AUDIENCE=
# Session lifetime in minutes, 5-1440 (default 120)
SESSION_TTL_MINUTES=
# mongodb:// or mongodb+srv:// connection string; required in production, unset uses the in-memory store
MONGO_URI=
# Database name (default chatterpay-analytics-dev); the required indexes must exist before startup
MONGO_DB_NAME=
# Connection string of the ChatterPay B2C database, with the database in its path; its `blockchains`
# collection lists the networks. Required in production; empty reuses MONGO_URI
B2C_MONGO_URI=
# B2C database used when B2C_MONGO_URI has no database in its path (default chatterpay-dev)
B2C_MONGO_DB_NAME=
# Service account whose Google ID token may call POST /v1/internal/ingest (Cloud Scheduler job identity); unset keeps it closed
INGEST_SCHEDULER_SA_EMAIL=
# aud of that token (the audience of the scheduler job); set together with INGEST_SCHEDULER_SA_EMAIL
INGEST_OIDC_AUDIENCE=
# true opens the ingestion endpoint to any caller for local runs (default false); refused in production
INGEST_DEV_TRIGGER=
# B2C transaction rows per batch, 100-10000 (default 1000)
INGEST_BATCH_SIZE=
# Ceiling on B2C transaction rows read per run (default 50000)
INGEST_MAX_TRANSACTIONS_PER_RUN=
# Rows inserted this many hours before a run are read again for status changes, 0 disables (default 72)
INGEST_REVISIT_HOURS=
# No batch starts after this many seconds; below the Cloud Run timeout and the scheduler deadline (default 480)
INGEST_MAX_RUN_SECONDS=
# none | coingecko: daily USD snapshot of the non-stable tokens (default none)
PRICES_PROVIDER=
# Ceiling on price provider requests per run, 0-5 (default 1)
PRICES_MAX_CALLS_PER_RUN=
# none | rpc: balance snapshot per run through the endpoints of the B2C blockchains collection (default none)
BALANCES_PROVIDER=
# Ceiling on balance requests per run (eth_call batches and Koios pages), 0-2000, 0 disables (default 100)
BALANCES_MAX_CALLS_PER_RUN=
# HTTPS Polygon mainnet JSON-RPC that answers eth_getLogs over 10000 blocks; unset reads no Polymarket fills
POLYMARKET_POLYGON_RPC_URL=
# Ceiling on Polygon requests per run for the Polymarket fills, 0-2000, 0 stops the reads (default 500)
POLYMARKET_MAX_CALLS_PER_RUN=
# JSON array of {network, address, role, nativeSymbol?}: public signer addresses only (default [])
MASTER_WALLETS=
# market | none: none computes no USD figure, for deployments on test networks (default market)
USD_VALUATION=
# Seconds between checks for a newer aggregate build (default 300)
METRICS_REFRESH_SECONDS=
